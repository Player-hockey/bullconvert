{
  "id": "./",
  "name": "BullConvert — конвертер файлов",
  "short_name": "BullConvert",
  "description": "Документы, PDF, книги, DjVu, фото, таблицы, аудио, видео и архивы — прямо на вашем устройстве.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111317",
  "theme_color": "#3b5bdb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "bullconvert.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "image/vnd.djvu": [".djvu", ".djv"],
        "application/epub+zip": [".epub"],
        "application/x-fictionbook+xml": [".fb2"]
      }
    }
  ]
}
